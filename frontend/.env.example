# Variables de entorno del FRONTEND (Vite).
# Copia este archivo a .env y ajusta los valores antes de compilar/ejecutar.
# No subas el .env real: contiene datos de conexión.

# Dirección IP publica o del servidor donde corre el BACKEND (no localhost).
# Es la URL base que usa Axios para todas las peticiones API.
VITE_API_URL=http://your_server_ip:3001/api

# IP del servidor PostgreSQL que se muestra en la pagina de Configuracion.
VITE_DB_HOST_DISPLAY=your_postgres_host