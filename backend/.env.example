# Variables de entorno del BACKEND (Node/Express + dotenv).
# Copia este archivo a .env en la RAÍZ del proyecto y ajusta los valores.
# No subas el .env real: contiene credenciales.

# --- Servidor backend ---
PORT=3001
HOST=0.0.0.0
NODE_ENV=production

# --- PostgreSQL (solo lectura) ---
DB_HOST=your_postgres_host_or_ip
DB_PORT=5432
DB_USER=your_user
DB_PASSWORD=your_password
DB_NAME=municipalizacion
DB_POOL_MAX=10
DB_IDLE_TIMEOUT=30000
DB_CONNECT_TIMEOUT=5000

# --- Oracle (nomina/personal) ---
ORACLE_USER=your_oracle_user
ORACLE_PASSWORD=your_oracle_password
ORACLE_CONNECT=(DESCRIPTION = (ADDRESS = (PROTOCOL = TCP)(HOST = your_oracle_host)(PORT = 1521))(CONNECT_DATA = (SERVER = DEDICATED) (SERVICE_NAME = your_service)))

# --- Auth / JWT ---
JWT_SECRET=change-this-to-a-random-secret
JWT_EXPIRES_IN=8h
ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=change-this-admin-password
ADMIN_DEFAULT_EMAIL=admin@yourdomain.com

# --- SQLite (auth) ---
# Ruta relativa a la carpeta backend/
SQLITE_DB_PATH=data/auth.db